                     <label className="block text-xs font-bold text-gray-600 mb-1">Contact Phone</label>
                     <input value={siteSettings.phone} onChange={e => setSiteSettings({...siteSettings, phone: e.target.value})} className="w-full border p-2 text-sm" />
                   </div>
                   <div>
                     <label className="block text-xs font-bold text-gray-600 mb-1">WhatsApp Number (e.g., 919876543210)</label>
                     <input value={siteSettings.whatsapp} onChange={e => setSiteSettings({...siteSettings, whatsapp: e.target.value})} className="w-full border p-2 text-sm" />
                   </div>
                 </div>
                 <div>
                   <label className="block text-xs font-bold text-gray-600 mb-1">Contact Email</label>
                   <input value={siteSettings.email} onChange={e => setSiteSettings({...siteSettings, email: e.target.value})} className="w-full border p-2 text-sm" />
                 </div>
                 
                 <h4 className="text-lg font-bold text-gray-800 mt-8 mb-4 border-b pb-2">Social Media Links</h4>
                 <div className="grid grid-cols-2 gap-4">
                   <div>
                     <label className="block text-xs font-bold text-gray-600 mb-1">Facebook URL</label>
                     <input value={siteSettings.facebook} onChange={e => setSiteSettings({...siteSettings, facebook: e.target.value})} className="w-full border p-2 text-sm" placeholder="https://facebook.com/..." />
                   </div>
                   <div>
                     <label className="block text-xs font-bold text-gray-600 mb-1">Instagram URL</label>
                     <input value={siteSettings.instagram} onChange={e => setSiteSettings({...siteSettings, instagram: e.target.value})} className="w-full border p-2 text-sm" placeholder="https://instagram.com/..." />
                   </div>
                   <div>
                     <label className="block text-xs font-bold text-gray-600 mb-1">X (Twitter) URL</label>
                     <input value={siteSettings.twitter} onChange={e => setSiteSettings({...siteSettings, twitter: e.target.value})} className="w-full border p-2 text-sm" placeholder="https://x.com/..." />
                   </div>
                   <div>
                     <label className="block text-xs font-bold text-gray-600 mb-1">YouTube URL</label>
                     <input value={siteSettings.youtube} onChange={e => setSiteSettings({...siteSettings, youtube: e.target.value})} className="w-full border p-2 text-sm" placeholder="https://youtube.com/..." />
                   </div>
                 </div>

                 <h4 className="text-lg font-bold text-gray-800 mt-8 mb-4 border-b pb-2">Other Marketplaces (Amazon, Flipkart, Meesho)</h4>
                 <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                   <div>
                     <label className="block text-xs font-bold text-gray-600 mb-1">Amazon Store URL</label>
                     <input value={siteSettings.amazon} onChange={e => setSiteSettings({...siteSettings, amazon: e.target.value})} className="w-full border p-2 text-sm" placeholder="https://amazon.in/..." />
                   </div>
                   <div>
                     <label className="block text-xs font-bold text-gray-600 mb-1">Flipkart Store URL</label>
                     <input value={siteSettings.flipkart} onChange={e => setSiteSettings({...siteSettings, flipkart: e.target.value})} className="w-full border p-2 text-sm" placeholder="https://flipkart.com/..." />
                   </div>
                   <div>
                     <label className="block text-xs font-bold text-gray-600 mb-1">Meesho Store URL</label>
                     <input value={siteSettings.meesho} onChange={e => setSiteSettings({...siteSettings, meesho: e.target.value})} className="w-full border p-2 text-sm" placeholder="https://meesho.com/..." />
                   </div>
                 </div>

                 <button onClick={() => setShowToast('Site Settings Updated Globally!')} className="mt-6 bg-[#2874f0] text-white px-6 py-2 rounded font-bold shadow-sm">Save Global Settings</button>
              </div>
           </div>
        )}
      </div>
    </div>
