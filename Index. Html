const generateProducts = () => {
  let allProducts = [];
  let idCounter = 1;
  const categoriesConfig = [
    { id: 'sarees', name: 'Saree', basePrice: 999, images: ['https://images.unsplash.com/photo-1610030469983-98e550d6193c?auto=format&fit=crop&w=600&q=80', 'https://images.unsplash.com/photo-1583391733956-6c78276477e2?auto=format&fit=crop&w=600&q=80'] },
    { id: 'kurti', name: 'Kurti Set', basePrice: 599, images: ['https://images.unsplash.com/photo-1595967783875-c3ed1690d7a5?auto=format&fit=crop&w=600&q=80'] },
    { id: 'men', name: 'Men Wear', basePrice: 499, images: ['https://images.unsplash.com/photo-1617137968427-85924c800a22?auto=format&fit=crop&w=600&q=80'] },
    { id: 'kids', name: 'Kids Outfit', basePrice: 399, images: ['https://images.unsplash.com/photo-1518831959646-742c3a14ebf7?auto=format&fit=crop&w=600&q=80'] },
    { id: 'jewellery', name: 'Jewellery Set', basePrice: 299, images: ['https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?auto=format&fit=crop&w=600&q=80'] },
    { id: 'bridal', name: 'Bridal Lehenga', basePrice: 4999, images: ['https://images.unsplash.com/photo-1589156229687-496a31ad1d1f?auto=format&fit=crop&w=600&q=80'] },
  ];
  const adjectives = ['Premium', 'Classic', 'Elegant', 'Designer'];
  const brands = ['Zivora', 'Soulmate', 'Trendz'];

  categoriesConfig.forEach(cat => {
    for(let i=0; i<6; i++) {
      let dynamicPrice = cat.basePrice + (Math.floor(Math.random() * 20) * 150);
      allProducts.push({
        id: idCounter++, title: `${adjectives[i % adjectives.length]} ${cat.name} - Latest Design`, brand: brands[i % brands.length], price: dynamicPrice, originalPrice: dynamicPrice * 2, discount: 50, stock: Math.floor(Math.random() * 50) + 1, rating: (4 + (i % 10) / 10).toFixed(1), reviews: 120 + i * 35, image: cat.images[i % cat.images.length], category: cat.id, assured: i % 3 === 0, description: `High quality ${cat.name} suitable for all occasions in Jamshedpur.`
      });
    }
  });

  const offers = allProducts.filter((_, idx) => idx % 4 === 0).map(p => ({ ...p, id: idCounter++, category: 'offers', discount: 75, originalPrice: p.price * 4, title: `Mega Deal: ${p.title}` }));
  return [...allProducts, ...offers];
};

