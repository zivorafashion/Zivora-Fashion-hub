  const renderLogin = () => (
    <div className="bg-[#f1f3f6] min-h-[80vh] flex items-center justify-center p-4">
      <div className="bg-white rounded-sm shadow-md flex w-full max-w-[700px] overflow-hidden min-h-[450px]">
        <div className="hidden md:flex flex-col bg-[#2874f0] text-white w-2/5 p-8 justify-between">
          <div>
            <h2 className="text-3xl font-bold mb-4">{isSignUp ? 'Looks like you\'re new here!' : 'Login'}</h2>
            <p className="text-gray-200 text-sm leading-relaxed font-medium">
              {isSignUp ? 'Sign up with your mobile number to get started' : 'Get access to your Orders, Wishlist and Recommendations'}
            </p>
          </div>
          <div className="mt-8 opacity-90">
             <div className="w-full h-32 bg-blue-400 rounded-md flex items-center justify-center">
                <User className="w-16 h-16 text-white" />
             </div>
          </div>
        </div>
        
        <div className="w-full md:w-3/5 p-8 flex flex-col justify-center bg-white relative">
          <div className="absolute top-4 right-4 cursor-pointer text-gray-400 hover:text-gray-600" onClick={() => setCurrentView('home')}>
             <X className="w-6 h-6" />
          </div>
          
          {isSignUp ? (
            <>
              <div className="mb-6"><input type="text" placeholder="Full Name" className="w-full border-b border-gray-300 py-2 focus:outline-none focus:border-[#2874f0] text-sm text-gray-800" /></div>
              <div className="mb-6"><input type="tel" placeholder="Mobile Number" className="w-full border-b border-gray-300 py-2 focus:outline-none focus:border-[#2874f0] text-sm text-gray-800" /></div>
              <div className="mb-6"><input type="password" placeholder="Set Password" className="w-full border-b border-gray-300 py-2 focus:outline-none focus:border-[#2874f0] text-sm text-gray-800" /></div>
            </>
          ) : (
            <>
              <div className="mb-8"><input type="text" placeholder="Enter Email/Mobile number" className="w-full border-b border-gray-300 py-2 focus:outline-none focus:border-[#2874f0] text-sm text-gray-800" /></div>
              <div className="mb-6"><input type="password" placeholder="Enter Password" className="w-full border-b border-gray-300 py-2 focus:outline-none focus:border-[#2874f0] text-sm text-gray-800" /></div>
            </>
          )}

          <p className="text-xs text-gray-500 mb-6">
            By continuing, you agree to {siteSettings.brandName}'s <span onClick={() => openPage('terms')} className="text-[#2874f0] cursor-pointer hover:underline mx-1">Terms of Use</span> and <span onClick={() => openPage('privacy')} className="text-[#2874f0] cursor-pointer hover:underline ml-1">Privacy Policy</span>.
          </p>
          <button onClick={() => { setShowToast(isSignUp ? 'Account Created!' : 'Login Successful!'); setCurrentView('home'); }} className="bg-[#fb641b] text-white font-bold py-3.5 rounded-sm shadow-sm hover:bg-[#f35200] transition w-full text-sm">
            {isSignUp ? 'CONTINUE' : 'LOGIN'}
          </button>
          <div onClick={() => setIsSignUp(!isSignUp)} className="mt-8 text-center text-sm text-[#2874f0] font-bold cursor-pointer hover:underline mt-auto">
            {isSignUp ? 'Existing User? Log in' : 'New to Zivora? Create an account'}
          </div>
        </div>
      </div>
    </div>
  );

  const renderFooter = () => (
    <footer className="bg-[#172337] text-white text-xs pt-12 pb-6 mt-auto">
      <div className="max-w-7xl mx-auto px-4 md:px-8 grid grid-cols-2 md:grid-cols-4 gap-8 mb-8 border-b border-gray-700 pb-8">
        <div>
          <h4 className="text-gray-400 font-medium mb-4 uppercase">About</h4>
          <ul className="space-y-2">
            <li><a href="#" onClick={(e) => { e.preventDefault(); openPage('contact'); }} className="hover:underline">Contact Us</a></li>
            <li><a href="#" onClick={(e) => { e.preventDefault(); openPage('about'); }} className="hover:underline">About Us</a></li>
            <li><a href="#" onClick={(e) => { e.preventDefault(); openPage('stories'); }} className="hover:underline">{siteSettings.brandName} Stories</a></li>
          </ul>
        </div>
        <div>
          <h4 className="text-gray-400 font-medium mb-4 uppercase">Help</h4>
          <ul className="space-y-2">
            <li><a href="#" onClick={(e) => { e.preventDefault(); openPage('payments'); }} className="hover:underline">Payments</a></li>
            <li><a href="#" onClick={(e) => { e.preventDefault(); openPage('shipping'); }} className="hover:underline">Shipping</a></li>
            <li><a href="#" onClick={(e) => { e.preventDefault(); openPage('cancellation'); }} className="hover:underline">Cancellation & Returns</a></li>
          </ul>
        </div>
        <div>
          <h4 className="text-gray-400 font-medium mb-4 uppercase">Policy</h4>
          <ul className="space-y-2">
            <li><a href="#" onClick={(e) => { e.preventDefault(); openPage('returns'); }} className="hover:underline">Return Policy</a></li>
            <li><a href="#" onClick={(e) => { e.preventDefault(); openPage('terms'); }} className="hover:underline">Terms Of Use</a></li>
            <li><a href="#" onClick={(e) => { e.preventDefault(); openPage('privacy'); }} className="hover:underline">Privacy</a></li>
          </ul>
        </div>
        <div className="border-l border-gray-700 pl-4 md:pl-8">
          <h4 className="text-gray-400 font-medium mb-4 uppercase">Registered Office:</h4>
          <p className="text-gray-300 leading-relaxed mb-4 whitespace-pre-line">{siteSettings.address}</p>
          <p className="text-gray-300 leading-relaxed font-bold mt-2">CEO: {siteSettings.ceo}</p>
          
          <h4 className="text-gray-400 font-medium mt-6 mb-4 uppercase">Follow Us</h4>
          <div className="flex space-x-4">
            {siteSettings.facebook && <a href={siteSettings.facebook} target="_blank" rel="noreferrer" className="text-gray-400 hover:text-[#2874f0] transition"><Facebook className="w-5 h-5" /></a>}
            {siteSettings.instagram && <a href={siteSettings.instagram} target="_blank" rel="noreferrer" className="text-gray-400 hover:text-pink-500 transition"><Instagram className="w-5 h-5" /></a>}
            {siteSettings.twitter && <a href={siteSettings.twitter} target="_blank" rel="noreferrer" className="text-gray-400 hover:text-blue-400 transition"><Twitter className="w-5 h-5" /></a>}
            {siteSettings.youtube && <a href={siteSettings.youtube} target="_blank" rel="noreferrer" className="text-gray-400 hover:text-red-500 transition"><Youtube className="w-5 h-5" /></a>}
          </div>

          {(siteSettings.amazon || siteSettings.flipkart || siteSettings.meesho) && (
            <>
              <h4 className="text-gray-400 font-medium mt-6 mb-4 uppercase">Shop Also On</h4>
              <div className="flex space-x-4 text-sm">
                {siteSettings.amazon && <a href={siteSettings.amazon} target="_blank" rel="noreferrer" className="text-gray-400 hover:text-orange-400 transition font-bold">Amazon</a>}
                {siteSettings.flipkart && <a href={siteSettings.flipkart} target="_blank" rel="noreferrer" className="text-gray-400 hover:text-blue-500 transition font-bold">Flipkart</a>}
                {siteSettings.meesho && <a href={siteSettings.meesho} target="_blank" rel="noreferrer" className="text-gray-400 hover:text-pink-500 transition font-bold">Meesho</a>}
              </div>
            </>
          )}
        </div>
      </div>
      
      <div className="max-w-7xl mx-auto px-4 text-center text-gray-500 flex flex-col md:flex-row justify-between items-center text-xs pb-4">
         <span>© 2026 {siteSettings.brandName}. All rights reserved.</span>
         <div className="flex items-center mt-4 md:mt-0">
           <span className="mr-2">Designed exclusively for {siteSettings.ceo}</span>
           <button onClick={() => { setCurrentView('admin_login'); window.scrollTo(0,0); }} className="bg-gray-800 text-gray-300 px-3 py-1 rounded-sm text-[10px] font-bold hover:bg-blue-600 hover:text-white transition-all shadow-sm ml-2">
             Admin Login
           </button>
         </div>
      </div>
    </footer>
  );

  return (
    <div className="font-sans flex flex-col min-h-screen bg-white">
      {showToast && (
        <div className="fixed top-20 left-1/2 transform -translate-x-1/2 bg-gray-800 text-white px-6 py-3 rounded shadow-xl z-50 flex items-center">
          <CheckCircle className="w-5 h-5 text-green-400 mr-2" />
          {showToast}
        </div>
      )}
      {renderNavbar()}
      {renderMobileMenu()}
      <main className="flex-grow">
        {currentView === 'home' && renderHome()}
        {currentView === 'product' && renderProduct()}
        {currentView === 'cart' && renderCart()}
        {currentView === 'checkout' && renderCheckout()}
        {currentView === 'login' && renderLogin()}
        {currentView === 'category' && renderCategoryView()}
        {currentView === 'search' && renderSearchView()}
        {currentView === 'wishlist' && renderProductGrid('My Wishlist', wishlist)}
        {currentView === 'admin_login' && renderAdminLogin()}
        {currentView === 'admin' && (isAdminAuthed ? renderAdminDashboard() : renderAdminLogin())}
        {['about', 'contact', 'orders', 'seller', 'payments', 'shipping', 'cancellation', 'returns', 'terms', 'privacy', 'stories'].includes(currentView) && renderInfoPage(currentView)}
      </main>
      {renderFooter()}

      <a 
        href={`https://api.whatsapp.com/send?phone=${siteSettings.whatsapp.replace(/[^0-9]/g, '')}`}
        target="_blank" 
        rel="noopener noreferrer"
        onClick={() => setShowToast('Opening WhatsApp...')}
        className="fixed bottom-6 right-6 bg-green-500 text-white p-4 rounded-full shadow-2xl hover:bg-green-600 transition z-50 flex items-center justify-center hover:scale-110"
      >
        <svg className="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.88-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
      </a>
    </div>
  );
}



